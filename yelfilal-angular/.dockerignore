# ============================================================================
# .dockerignore - yelfilal-angular
# Fichiers exclus du contexte de build Docker.
# Un motif sans « **/ » ne vise que la racine du contexte.
# ============================================================================

# Dépendances (installées dans le conteneur)
node_modules/
.npm/

# Sorties de build
dist/
.angular/

# Git
.git/
.gitignore

# Fichiers d'IDE et d'éditeur
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~

# Documentation (inutile dans le conteneur)
**/*.md
docs/

# Fichiers d'environnement (secrets)
**/.env
**/.env.local
**/.env.*.local

# Tests
coverage/
**/*.spec.ts

# Logs
**/*.log

# Fichiers système
**/.DS_Store
**/Thumbs.db

# Fichiers Docker (inutiles dans le conteneur)
Dockerfile*
docker-compose*.yml
.dockerignore
